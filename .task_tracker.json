{
  "task_description": "{'component_name': 'Main Container for AppVote Portal', 'description': 'Primary container for AppVote Portal implementation: A modern portal for app submission and voting contests. Users can register/login, submit apps, and vote for their favorites. Admins manage contests, view all submissions with user details, export top apps, and declare winners. Features anonymous voting and contest-based participation. Built with a white and blue theme and Supabase backend integration.', 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "User Registration & Login",\n      "description": "Users can register and login to access the portal using secure authentication.",\n      "isEnabled": true\n    },\n    {\n      "name": "App Submission",\n      "description": "Users can submit their app with name, link, preview image, and username. Submissions are visible on the home page as cards.",\n      "isEnabled": true\n    },\n    {\n      "name": "Voting System",\n      "description": "Each user can vote for up to 5 apps per contest. Voting is anonymous and users cannot vote for their own app.",\n      "isEnabled": true\n    },\n    {\n      "name": "Admin Dashboard",\n      "description": "Admins can view all app submissions with user details, votes, and ranking in a sortable table. Admins can export the top 10 apps as an Excel file.",\n      "isEnabled": true\n    },\n    {\n      "name": "Contest Management",\n      "description": "Admins can start/end weekly contests (Week 1-4). Users can submit/vote only during active contests. Admins can declare three winners from the top 10 apps.",\n      "isEnabled": true\n    },\n    {\n      "name": "Winner Announcement",\n      "description": "After contest ends and winners are declared, users can view the contest winners.",\n      "isEnabled": true\n    },\n    {\n      "name": "Supabase Integration",\n      "description": "All backend data (users, apps, votes, contests, images) is managed via Supabase, including an image bucket for app previews.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#1976D2",\n    "secondary": "#FFFFFF",\n    "accent": "#1565C0"\n  },\n  "theme": "light",\n  "layoutDescription": "The portal features a clean, modern UI with a white and blue color scheme. The home page displays app cards with preview images and links. Navigation includes Home, Add Your App, and Contest Winners. Admins have a dashboard with a sortable table and export options. Forms and dialogs use blue accents for actions and highlights."\n}'}",
